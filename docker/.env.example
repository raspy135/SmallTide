# Settings for docker/compose.yaml. Copy to docker/.env and uncomment what you need:
#   cp docker/.env.example docker/.env
# then apply changes with: docker compose -f docker/compose.yaml up -d
#
# The same file works with docker run (--env-file docker/.env) and the quadlet (EnvironmentFile=).
#
# Two kinds of settings live here:
#   1. Container settings: how the container is started (port, data location, image).
#   2. Engine settings: anything smalltide-cli reads (VRAM use, context, rescue tuning, ...). They
#      override the same key in the engine .env inside the data volume, which is created on first
#      start from the headless or monitor template and holds the defaults for everything else.

# =============================================================================================
# 1. Container
# =============================================================================================

# Engine template for the first start (ignored once the data volume has a .env):
#   headless  monitor on the motherboard or another GPU: the card holds only the model
#   monitor   monitor plugged into the Radeon card: 128K context and smaller rescue budgets,
#             leaving VRAM for the desktop
#SMALLTIDE_CONFIG=headless

# Address the port is published on. 127.0.0.1 keeps it on this machine. 0.0.0.0 opens it to your
# network: the API has no authentication, so only do that on a trusted network or behind a reverse
# proxy that checks credentials. Docker's port rules bypass firewalld and ufw.
#SMALLTIDE_BIND=127.0.0.1

# Port on this machine. (The server always listens on 8000 inside the container.)
#SMALLTIDE_PUBLISH_PORT=8000

# Absolute host directory for the engine .env, the model (about 21 GB) and the routing priors.
# Default: the named volume smalltide-data. To reuse a model you already have, put its
# Inkling-2-Mini (and Inkling-2-Mini-DFlash2) directories in a models/ directory inside it.
#SMALLTIDE_DATA=/path/to/smalltide

# Supplementary group that grants GPU access: video for Docker and rootful Podman,
# keep-groups for rootless Podman.
#SMALLTIDE_GROUP=video

# Image to run (or the tag given to an `up --build` image).
#SMALLTIDE_IMAGE=ghcr.io/raspy135/smalltide:latest

# 0 stops instead of downloading the model when the data volume has none.
#SMALLTIDE_AUTO_SETUP=1

# Optional, for higher Hugging Face rate limits on the first-start download.
#HF_TOKEN=

# =============================================================================================
# 2. Engine (the most useful knobs; the full list is in README.md under "Tuning .env")
# =============================================================================================

# --- VRAM -------------------------------------------------------------------------------------
# GPU to use when the machine has more than one, as a HIP device index (0, 1, ...). By default the
# engine picks the discrete card with the most VRAM, even if another workload already fills it.
#SMALLTIDE_HIP_DEVICE=1

# VRAM left free for other programs on the card (the desktop, a browser), in MiB. Raise it if the
# desktop stutters or other GPU apps fail to allocate; lower it to keep more experts on the card.
#SMALLTIDE_RESIDENT_MARGIN_MB=768

# Expert slots on the card. auto fills the VRAM left after the engine buffers and the margin above;
# a number caps them (fewer slots = less VRAM, more experts read from RAM).
#SMALLTIDE_NVFP4_SLOTS=auto
#SMALLTIDE_MXFP8_SLOTS=auto

# Context length and the KV pool ceiling. The KV pool starts at KV_INITIAL_TOKENS and grows on long
# prompts by borrowing expert slots, so a lower ceiling protects resident experts.
# headless template: 196608, monitor template: 131072 (up to 262144).
#SMALLTIDE_MAX_CTX=131072
#SMALLTIDE_KV_TOKENS=131072
#SMALLTIDE_MAX_TOKENS=131072
#SMALLTIDE_KV_INITIAL_TOKENS=32768

# Dense weights: fp8 (about 1.1 GiB, for 16 GB cards) or bf16 (about 2.2 GiB, exact checkpoint
# weights, for the 32 GB R9700).
#SMALLTIDE_DENSE_FMT=fp8

# Prefill scratch: 64 to 1024 tokens per chunk. Larger reads prompts faster but costs VRAM
# (1024 costs about 80 resident experts compared with 256).
#SMALLTIDE_PREFILL_CHUNK=512

# --- System RAM -------------------------------------------------------------------------------
# Host RAM for experts that are not on the card (about 4.8 MiB each); 16 holds all 3,072.
# A 32 GB card (R9700) holds every expert, so 0 frees this RAM for the prefix cache and the host.
#SMALLTIDE_RAM_GB=10

# Prompt prefix cache in page-locked host RAM: a follow-up request resumes from a snapshot instead
# of reading the whole conversation again. When full it takes about 15 KB per token plus about
# 170 MB per snapshot: the headless template (196608 tokens, 8 snapshots) reaches about 4.2 GB,
# 65536 tokens and 6 snapshots about 2 GB. Keep room for two or three snapshots of your longest
# conversation. If the host runs out of memory the kernel kills the server (exit code 137).
#SMALLTIDE_PREFIX_TOKENS=196608
#SMALLTIDE_PREFIX_SNAPSHOTS=8

# --- Serving ----------------------------------------------------------------------------------
# Concurrent requests (each extra lane costs about 3.7 MiB of VRAM).
#SMALLTIDE_LANES=4

# Speculative decoding on (1) or off (0).
#SMALLTIDE_SPEC=1

# Inline expert rescue: threshold (balanced), exact (bit-exact MoE, slower) or disabled (fastest).
#SMALLTIDE_RESCUE_MODE=threshold
